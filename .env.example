# Jarvis Assistant Environment Variables
# Copy this file to .env and fill in your actual values

# ==================================================
# REQUIRED API KEYS
# ==================================================

# ElevenLabs Text-to-Speech API Key
# Get from: https://elevenlabs.io/
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# OpenAI API Key for conversational AI
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# OpenWeatherMap API Key for weather data
# Get from: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# SerpAPI Key for web search
# Get from: https://serpapi.com/
SERPAPI_API_KEY=your_serpapi_key_here

# NewsAPI Key for news headlines
# Get from: https://newsapi.org/
NEWSAPI_API_KEY=your_newsapi_key_here

# ==================================================
# SECURITY CONFIGURATION
# ==================================================

# MCP Server API Key - Generate a secure random key
# Use: openssl rand -hex 32
MCP_API_KEY=generate_secure_random_key_here
