# Jarvis environment variables. Copy to .env and fill in what you need.
# Every key is optional except MCP_API_KEY; features without a key report
# "not configured" instead of crashing.

# --- MCP tool server (required) ---------------------------------------------
# Shared secret between Jarvis and its MCP server (Bearer token).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_API_KEY=CHANGE_ME_TO_SECURE_RANDOM_KEY
# MCP_HOST=127.0.0.1
# MCP_PORT=8000
# Where Jarvis reaches the tool server (default http://127.0.0.1:$MCP_PORT)
# MCP_SERVER_URL=http://127.0.0.1:8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_PER_MINUTE=60
# Allow the whitelisted "system" tool commands (only an echo test by default)
SYSTEM_COMMANDS_ENABLED=false

# --- Conversation (LLM fallback when no built-in command matches) ------------
# OpenAI is used if set; otherwise a local Ollama on localhost:11434 if running.
OPENAI_API_KEY=

# --- Voice output ------------------------------------------------------------
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# --- Speech recognition -------------------------------------------------------
# Overrides config.json "speech_recognition.engine": google | whisper | remote
# SPEECH_RECOGNITION_ENGINE=whisper
# For engine=remote, a jarvis-gpu-transcription server:
# SPEECH_RECOGNITION_REMOTE_URL=http://192.168.1.50:8000
# SPEECH_RECOGNITION_REMOTE_MODE=fast
# TRANSCRIPTION_API_KEY=

# --- MCP tool API keys --------------------------------------------------------
OPENWEATHER_API_KEY=
SERPAPI_KEY=
NEWS_API_KEY=
# Crypto prices use CoinGecko's public API and need no key.
# Gmail / Google Calendar use OAuth files in credentials/ (see setup_google_credentials.py).
