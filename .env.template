# Jarvis Assistant Environment Variables
# Copy this file to .env and fill in your API keys

# ElevenLabs TTS API Key
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# OpenWeatherMap API Key  
OPENWEATHER_API_KEY=your_openweather_api_key_here

# SerpAPI Key for web search
SERPAPI_KEY=your_serpapi_key_here

# NewsAPI Key
NEWS_API_KEY=your_newsapi_key_here

# MCP Server API Key (for internal authentication) - CHANGE THIS!
# Generate a secure random key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_API_KEY=CHANGE_ME_TO_SECURE_RANDOM_KEY

# Optional: OpenAI API Key (for future LLM integration)
# OPENAI_API_KEY=your_openai_api_key_here

# Optional: Google OAuth credentials (for Gmail/Calendar)
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret

# Security Configuration
# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate limiting (requests per minute)
RATE_LIMIT_PER_MINUTE=60

# Enable/disable system commands (true/false)
SYSTEM_COMMANDS_ENABLED=false